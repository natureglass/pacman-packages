@@ -6813,6 +6814,22 @@ class Handlers : public HandlersBase {
     }
 
     NextOp();
+#else   // V8_COMPRESS_POINTERS
+    // switch-v8 fork (NXJS_PATCHES_NEEDED.md #74 Track B): array.fill on
+    // wasm-gc ref arrays is unsupported under pointer-compression-off.
+    // The handler must still exist because its address is odr-used by
