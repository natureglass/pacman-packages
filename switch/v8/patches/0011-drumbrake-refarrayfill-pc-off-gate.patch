   INSTRUCTION_HANDLER_FUNC s2s_RefArrayFill(
       const uint8_t* code, uint32_t* sp, WasmInterpreterRuntime* wasm_runtime,
       int64_t r0, double fp0) {
+#ifdef V8_COMPRESS_POINTERS
